<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FdBg" Color="#0E0A18"/>
          <SolidColorBrush x:Key="FdSurface" Color="#171126"/>
          <SolidColorBrush x:Key="FdSurface2" Color="#1F1833"/>
          <SolidColorBrush x:Key="FdBorder" Color="#2E2550"/>
          <SolidColorBrush x:Key="FdText" Color="#F3EFFA"/>
          <SolidColorBrush x:Key="FdTextMuted" Color="#A59CC0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FdBg" Color="#F6F3FC"/>
          <SolidColorBrush x:Key="FdSurface" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="FdSurface2" Color="#EFEAFA"/>
          <SolidColorBrush x:Key="FdBorder" Color="#DDD5F0"/>
          <SolidColorBrush x:Key="FdText" Color="#1B1430"/>
          <SolidColorBrush x:Key="FdTextMuted" Color="#6B6285"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- Плавное появление страниц (можно отключить в настройках) -->
  <Style Selector="Window.anim UserControl.page">
    <Style.Animations>
      <Animation Duration="0:0:0.25">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource FdTextMuted}"/></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="#F59E0B"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#F87171"/><Setter Property="TextWrapping" Value="Wrap"/></Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource FdSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FdBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10"/></Style>

  <!-- Кнопки -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource FdGradient}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15"/></Transitions></Setter>
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdGradient}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdGradient}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdGradient}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pointerover"><Setter Property="Opacity" Value="0.9"/></Style>
  <Style Selector="Button.primary:disabled"><Setter Property="Opacity" Value="0.45"/></Style>

  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FdBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
  </Style>

  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B42343"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D12A52"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- Навигация -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="10,9"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdSurface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FdAccent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
  </Style>

  <!-- Вкладки/чипы -->
  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="14,6"/>
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdSurface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FdBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource FdText}"/>
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdBorder}"/>
  </Style>
  <Style Selector="Button.chip.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FdGradient}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- Кнопка-карточка -->
  <Style Selector="Button.cardbtn">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="14"/>
  </Style>
  <Style Selector="Button.cardbtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.cardbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.cardbtn:pointerover Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource FdAccent}"/>
  </Style>
</Styles>
